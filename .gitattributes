# Les CSV RH transmis utilisent des fins de ligne CRLF et un BOM UTF-8.
# On conserve ces fichiers tels quels ; le CR final ne doit pas être signalé comme espace traînant.
*.csv whitespace=cr-at-eol

# Les chaînes de certaines dépendances embarquées conservent leurs espaces significatifs.
index.html whitespace=-blank-at-eol
